.DS_Store

# Secrets & local env
.env
.env.*
!.env.example

# Logs & pidfiles
.logs/
*.log
*.pid

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
server/dist/
server/build/

# Node / web
node_modules/
web/dist/
# web/src/client/ (the generated TS client) is committed on purpose (story
# 1.10, finding 1): a fresh clone must build without a live api. Refresh it
# with `make client`.
*.tsbuildinfo
.pnpm-store/

# Editors / OS
.idea/
# Anchored to the repo root (web/.gitignore governs web/.vscode itself);
# keep the extensions.json exception working.
.vscode/*
!.vscode/extensions.json
.playwright-mcp/

# Build output.
.dist/

# BMad working output is local by default. Story 6.1's canonical UX design is
# the one explicit exception; studies, screenshots, memlogs, and snapshots stay
# local so the tracked surface remains the builder-facing design of record.
_bmad-output/*
!_bmad-output/planning-artifacts/
_bmad-output/planning-artifacts/*
!_bmad-output/planning-artifacts/ux-designs/
_bmad-output/planning-artifacts/ux-designs/*
!_bmad-output/planning-artifacts/ux-designs/ux-meetingminer-2026-08-29/
_bmad-output/planning-artifacts/ux-designs/ux-meetingminer-2026-08-29/*
!_bmad-output/planning-artifacts/ux-designs/ux-meetingminer-2026-08-29/DESIGN.md
!_bmad-output/planning-artifacts/ux-designs/ux-meetingminer-2026-08-29/EXPERIENCE.md
!_bmad-output/planning-artifacts/ux-designs/ux-meetingminer-2026-08-29/adoption.md
!_bmad-output/planning-artifacts/ux-designs/ux-meetingminer-2026-08-29/findings-for-epics.md
!_bmad-output/planning-artifacts/ux-designs/ux-meetingminer-2026-08-29/validation-report.md
!_bmad-output/planning-artifacts/ux-designs/ux-meetingminer-2026-08-29/validation-report.html
!_bmad-output/planning-artifacts/ux-designs/ux-meetingminer-2026-08-29/mockups/
_bmad-output/planning-artifacts/ux-designs/ux-meetingminer-2026-08-29/mockups/*
!_bmad-output/planning-artifacts/ux-designs/ux-meetingminer-2026-08-29/mockups/*.html

# Vendored agent skill trees (per-machine copies; the installer regenerates them).
.agents/
.claude/
