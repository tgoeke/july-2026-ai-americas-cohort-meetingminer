# MeetingMiner secrets + the two storage roots (AD-10). Copy to .env and fill in.
# .env is gitignored; it carries secrets and the two roots only —
# every non-secret adapter binding belongs in config.yaml.
#
# Dialect (story 1.10): this file is read by BOTH the Python loader
# (python-dotenv) and docker compose --env-file. These constructs resolve to
# the identical value in both:
#   KEY=value               unquoted; `  # comment` after whitespace is stripped
#   KEY="value"             quoted; keeps spaces and `#` verbatim — quote any
#                           secret that contains `#`, spaces, or quotes
#   export KEY=value        the `export ` prefix is accepted and ignored
#   KEY="${OTHER}"          double quotes interpolate: `${VAR}` expands in both
#   KEY='raw $literal'      single quotes are literal in both — the only way
#                           to carry a `$` through unexpanded
#
# Two behaviors are loader-only, because compose has no equivalent:
#   MM_CONTENT_ROOT=~/dir   a leading `~` is expanded by the loader only;
#                           compose passes `~` through literally, so use an
#                           absolute path for anything compose also reads
#   export VAR=  (blank)    a blank variable exported in your shell does not
#                           mask the value set here; compose instead fails
#                           loudly on a required variable, which is fine —
#                           but it is not the same behavior

# The two path anchors (AD-3, `storage-layout.md`). Every path in the database
# is relative to exactly one of them and never absolute, so relocating either
# is an environment change rather than a data migration. Both are permanent
# storage and must be backed up together.

# Material this pipeline PRODUCED: frames, screenshots, extracted audio, under
# meetings/<meeting_id>/. The worker validates it at startup and refuses to run
# without a usable one (it creates the directory when missing, but the path
# must be absolute and writable).
MM_CONTENT_ROOT=/Users/you/meetingminer-content

# Material that ARRIVED: the write-once source drops, one directory per drop,
# each holding metadata.json plus the recording and/or transcripts. Nothing
# MeetingMiner runs ever writes inside it (AD-13), so it is never created for
# you — the api and the worker both refuse to start when it is missing. NOT a
# landing zone: ingested drops are re-read for transcript re-parse, for replay
# and for the augmentation comparison, so deleting one breaks the meeting.
MM_DROPS_ROOT=/Users/you/meetingminer-drops

# The publish folder (story 4.3, `storage-layout.md` §1): a third configured
# location, deliberately not a third path anchor. The api writes into it once
# per publish gesture — a markdown export per artifact, plus a git commit for
# each ADR, in a plain local git repository rooted here. Nothing in
# MeetingMiner re-reads a stored path against it at request time, but it is
# still human-curated state (approvals and publishes are not reconstructable
# from source drops) and must be backed up alongside the two roots above.
MM_PUBLISH_ROOT=/Users/you/meetingminer-publish

# Model provider API keys (leave blank for providers you do not use)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Hugging Face token for the optional pyannote diarizer (accept the gated model licence on huggingface.co first)
HF_TOKEN=

# Data store passwords / keys (docker-compose reads these too)
POSTGRES_PASSWORD=meetingminer-dev
NEO4J_PASSWORD=meetingminer-dev
MEILI_MASTER_KEY=meetingminer-dev-master-key
